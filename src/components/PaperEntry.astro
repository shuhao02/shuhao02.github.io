---
import { selfName } from '../data/site';

// Render one publication row inside a soft gray card.
// Layout: title, authors, "venue · [rating chip]", optional links.

interface Props {
  title: string;
  authors: string[];
  venue: string;
  rating?: string;
  tldr?: string;
  links?: Record<string, string>;
  highlight?: boolean;
}

const {
  title,
  authors,
  venue,
  rating,
  tldr,
  links,
  highlight = false,
} = Astro.props;

// Treat author entries as name-plus-marker: a trailing `*` or `†` indicates
// equal contribution / corresponding author. We strip those markers when
// matching against selfName so the author is still bolded correctly.
const stripMarker = (s: string) => s.replace(/[*†‡]+$/, '').trim();
const selfBase = stripMarker(selfName);

const renderedAuthors = authors
  .map((name) =>
    stripMarker(name) === selfBase ? `<strong>${name}</strong>` : name
  )
  .join(', ');

const hasEqualContribution = authors.some((a) => /\*$/.test(a.trim()));

// Pick a chip color class based on the rating prefix.
// CCF-A → strong blue; CCF-B → muted blue-gray; JCR Q1 → green;
// anything else → default neutral.
function ratingClass(r: string): string {
  const norm = r.trim().toUpperCase();
  if (norm.startsWith('CCF-A')) return 'rating-ccf-a';
  if (norm.startsWith('CCF-B')) return 'rating-ccf-b';
  if (norm.startsWith('JCR Q1') || norm.startsWith('JCR-Q1')) return 'rating-jcr-q1';
  return 'rating-default';
}

// Preferred order for the link row. Unknown keys are appended after these.
const linkOrder = [
  'paper',
  'arxiv',
  'pdf',
  'code',
  'project',
  'video',
  'slides',
  'poster',
  'bibtex',
  'scholar',
];

const orderedLinks: Array<[string, string]> = links
  ? [
      ...linkOrder
        .filter((k) => k in links)
        .map<[string, string]>((k) => [k, links[k]!]),
      ...Object.entries(links).filter(([k]) => !linkOrder.includes(k)),
    ]
  : [];
---

<article class={`paper${highlight ? ' is-highlight' : ''}`}>
  <h3 class="paper-title">{title}</h3>
  <p class="paper-authors" set:html={renderedAuthors}></p>
  <p class="paper-venue">
    <span>{venue}</span>
    {rating && <span class={`rating-chip ${ratingClass(rating)}`}>{rating}</span>}
  </p>
  {hasEqualContribution && <p class="paper-note">* Equal contribution.</p>}
  {tldr && <p class="paper-tldr">{tldr}</p>}
  {
    orderedLinks.length > 0 && (
      <p class="paper-links">
        {orderedLinks.map(([key, url], i) => (
          <>
            {i > 0 && <span class="sep">/</span>}
            <a href={url} target="_blank" rel="noopener noreferrer">{key}</a>
          </>
        ))}
      </p>
    )
  }
</article>
